{% extends 'base.html.twig' %}

{% block page_title %}Date et Heure{% endblock %}

{% block body %}
    <p><strong>Date courante :</strong> {{ date|date('d/m/Y') }}</p>
    <p><strong>Heure courante :</strong> {{ date|date('H:i:s') }}</p>
    <p><strong>Format complet :</strong> {{ date|date('d/m/Y H:i:s') }}</p>
{% endblock %}
